{
  "name": "react-native-components",
  "version": "0.1.0",
  "description": "Shared React Native components for the application.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run src/media-cache/core/__tests__",
    "test:media": "vitest run src/media/core/__tests__",
    "test:video": "vitest run src/components/MyVideo/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-native-nitro-compressor": "workspace:*",
    "react-native-popup-kit": "workspace:*",
    "react-native-nitro-visibility-observer": "workspace:*"
  },
