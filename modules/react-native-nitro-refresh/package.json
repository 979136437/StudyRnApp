{
  "name": "react-native-nitro-refresh",
  "version": "0.1.0",
  "description": "A highly customizable pull-to-refresh control for React Native built with Nitro Modules and Fabric.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "react-native.config.js",
    "NitroRefresh.podspec",
    "README.md"
  ],
  "scripts": {
    "specs": "nitrogen",
    "test": "vitest run src/core/__tests__",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": ">=0.10.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "nitrogen": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-worklets": "0.10.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "codegenConfig": {
    "name": "NitroRefreshSpec",
    "type": "components",
    "jsSrcsDir": "./src/fabric",
    "android": {
      "javaPackageName": "com.margelo.nitro.refresh"
    },
    "ios": {
      "componentProvider": {
        "NitroRefreshControlView": "NitroRefreshControlComponentView"
      }
    }
  },
  "keywords": [
    "react-native",
    "nitro",
    "refresh-control",
    "pull-to-refresh"
  ],
  "license": "MIT",
  "private": true
}
