{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["visibilityobserver"],
  "ios": {
    "iosModuleName": "NitroVisibilityObserver"
  },
  "android": {
    "androidNamespace": ["visibilityobserver"],
    "androidCxxLibName": "NitroVisibilityObserver"
  },
  "autolinking": {
    "VisibilityObserverView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVisibilityObserverView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridVisibilityObserverView"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
