{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["recyclerlist"],
  "ios": {
    "iosModuleName": "NitroRecyclerList"
  },
  "android": {
    "androidNamespace": ["recyclerlist"],
    "androidCxxLibName": "NitroRecyclerList"
  },
  "autolinking": {
    "RecyclerListView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRecyclerListView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRecyclerListView"
      }
    },
    "RecyclerCellHostView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRecyclerCellHostView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRecyclerCellHostView"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "**/__tests__/**"]
}
