{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["pickerview"],
  "ios": {
    "iosModuleName": "NitroPickerView"
  },
  "android": {
    "androidNamespace": ["pickerview"],
    "androidCxxLibName": "NitroPickerView"
  },
  "autolinking": {
    "PickerView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridPickerView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridPickerView"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
