{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["logger"],
  "ios": { "iosModuleName": "NitroLogger" },
  "android": {
    "androidNamespace": ["logger"],
    "androidCxxLibName": "NitroLogger"
  },
  "autolinking": {
    "NativeLogger": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridNativeLogger"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridNativeLogger"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
