{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 80,
  "endOfLine": "lf",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codegraph/**",
    "android/app/build/**",
    "dist/**",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
