{
  "name": "my-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@quidone/react-native-wheel-picker": "^1.7.1",
    "@shopify/flash-list": "2.0.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.7",
    "expo-audio": "~57.0.3",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "expo-video-metadata": "^1.5.0",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-modal-sheet": "^5.6.0",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-popover-view": "^6.1.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx}\"",
    "lint:fix": "oxlint --fix . && oxfmt \"src/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "build:android:development": "eas build --profile development --platform android",
    "build:android:production": "eas build --profile production --platform android",
    "build:ios:development": "eas build --profile development --platform ios",
    "build:ios:production": "eas build --profile production --platform ios",
    "build:development": "eas build --profile development --platform all",
    "build:production": "eas build --profile production --platform all",
    "run:android": "expo run:android --device",
    "run:ios": "expo run:ios --device"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0"
}
