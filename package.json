    "@expo/metro-runtime": "~57.0.8",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@quidone/react-native-wheel-picker": "^1.7.1",
    "@react-native-async-storage/async-storage": "catalog:",
    "@sentry/react-native": "catalog:",
    "@shopify/flash-list": "2.0.2",
    "clsx": "^2.1.1",
    "expo": "~57.0.9",
    "expo-application": "catalog:",
    "expo-asset": "catalog:",
    "expo-audio": "catalog:",
    "expo-camera": "~57.0.3",
    "expo-constants": "catalog:",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "catalog:",
    "expo-font": "~57.0.1",
    "expo-image": "catalog:",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.7",
    "expo-media-library": "~57.0.3",
    "expo-network": "~57.0.1",
    "expo-router": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "catalog:",
    "expo-video-metadata": "^1.5.0",
    "lottie-react-native": "~7.3.8",
    "nativewind": "catalog:",
    "react": "catalog:",
    "react-dom": "19.2.3",
    "react-modal-sheet": "^5.6.0",
    "react-native": "catalog:",
    "react-native-components": "workspace:*",
    "react-native-css-interop": "0.2.6",
    "react-native-diagnostics": "workspace:*",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-popup-kit": "workspace:*",
    "react-native-nitro-modules": "catalog:",
    "react-native-nitro-image-picker": "workspace:*",
    "react-native-nitro-picker-view": "workspace:*",
    "react-native-nitro-refresh": "workspace:*",
    "react-native-nitro-visibility-observer": "workspace:*",
    "react-native-pager-view": "8.0.2",
    "react-native-popover-view": "^6.1.0",
    "react-native-reanimated": "catalog:",
    "react-native-reanimated-carousel": "catalog:",
    "react-native-request-kit": "workspace:*",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@types/react": "catalog:",
    "babel-preset-expo": "~57.0.5",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react-doctor": "0.7.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "pnpm dlx expo-doctor",
    "lint": "oxlint . && oxfmt --check \"src/**/*.{js,jsx,ts,tsx}\" \"plugins/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx}\"",
    "lint:fix": "oxlint --fix . && oxfmt \"src/**/*.{js,jsx,ts,tsx}\" \"plugins/**/*.{js,jsx,ts,tsx}\" \"*.{js,jsx}\"",
    "test:diagnostics": "vitest run modules/react-native-diagnostics/src/core/__tests__",
    "typecheck": "tsc --noEmit",
    "build:android:development": "eas build --profile development --platform android --non-interactive",
    "build:android:production": "eas build --profile production --platform android --non-interactive",
    "build:ios:development": "eas build --profile development --platform ios --non-interactive",
    "build:ios:production": "eas build --profile production --platform ios --non-interactive",
    "build:development": "eas build --profile development --platform all --non-interactive",
    "build:production": "eas build --profile production --platform all --non-interactive",
    "run:android": "expo run:android --device",
    "run:ios": "expo run:ios --device",
    "postinstall": "pnpm doctor",
    "reInstall": "rimraf node_modules && rimraf pnpm-lock.yaml && pnpm install",
    "react-doctor": "npx react-doctor@latest"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
